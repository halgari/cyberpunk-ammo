module AmmoOverhaul.Localization

// Generated by tools/rounds/rounds.py (Rare and Epic rounds); edit there.
public abstract class AORoundTexts {
  // Key, text, key, text, ...
  public static func Pairs() -> array<String> {
    let t: array<String>;
    ArrayPush(t, "AO-Ammo-9mm-SteelCore"); ArrayPush(t, "9mm Steel-Core");
    ArrayPush(t, "AO-Ammo-SteelCore-Desc"); ArrayPush(t, "A steel penetrator under the copper jacket. It gets through vests that stop Ball, but it doesn't open up in flesh.\n\nIgnores 25% of armor. -10% damage.");
    ArrayPush(t, "AO-Ammo-9mm-Incendiary"); ArrayPush(t, "9mm Incendiary");
    ArrayPush(t, "AO-Ammo-9mm-Incendiary-Desc"); ArrayPush(t, "A pinch of incendiary mix in the tip. It flashes when it hits, but a 9 doesn't carry much of it.\n\n8% chance to set the target on fire. A quarter of the damage is fire damage. -5% damage.");
    ArrayPush(t, "AO-Ammo-9mm-Subsonic"); ArrayPush(t, "9mm Subsonic");
    ArrayPush(t, "AO-Ammo-Subsonic-Desc"); ArrayPush(t, "Heavy bullets loaded slow, under the speed of sound. A lot quieter, so a kill can stay quiet, but they drop sooner and hit softer.\n\nMuch quieter shots. Silent kills. -10% damage. -10% range.");
    ArrayPush(t, "AO-Ammo-9mm-Bouncers"); ArrayPush(t, "9mm Bouncers");
    ArrayPush(t, "AO-Ammo-Bouncers-Desc"); ArrayPush(t, "Hard-nosed rounds that skip off walls and floors instead of flattening. Handy around cover if you know your angles.\n\n30% chance to ricochet once. -15% damage.");
    ArrayPush(t, "AO-Ammo-9mm-Rubber"); ArrayPush(t, "9mm Rubber");
    ArrayPush(t, "AO-Ammo-Rubber-Desc"); ArrayPush(t, "Hard rubber bullets for riot work. They hurt and knock people around, but they rarely kill.\n\nNon-lethal: targets go down unconscious instead of dying. Much stronger flinch. -40% damage.");
    ArrayPush(t, "AO-Ammo-9mm-Penetrator"); ArrayPush(t, "9mm Penetrator");
    ArrayPush(t, "AO-Ammo-Penetrator-Desc"); ArrayPush(t, "Tungsten-core rounds. Armor barely slows them down.\n\nIgnores 60% of armor.");
    ArrayPush(t, "AO-Ammo-9mm-Match"); ArrayPush(t, "9mm Match");
    ArrayPush(t, "AO-Ammo-Match-Desc"); ArrayPush(t, "Hand-loaded, every charge weighed. Each shot hits about the same, and the gun groups tighter.\n\nDamage varies -2% to +6% instead of -10% to +1%. 30% less spread and sway.");
    ArrayPush(t, "AO-Ammo-9mm-Toxin"); ArrayPush(t, "9mm Toxin Core");
    ArrayPush(t, "AO-Ammo-Toxin-Desc"); ArrayPush(t, "A hollow core packed with toxin. Whatever it hits gets a dose.\n\n25% chance to poison. 30% of the damage is chemical damage.");
    ArrayPush(t, "AO-Ammo-9mm-Shredders"); ArrayPush(t, "9mm Shredders");
    ArrayPush(t, "AO-Ammo-Shredders-Desc"); ArrayPush(t, "Pre-fragmented bullets that break apart inside the target. The wounds bleed, and limbs come off easier.\n\n30% chance to cause bleeding. Twice the dismemberment chance.");
    ArrayPush(t, "AO-Ammo-9mm-CookOff"); ArrayPush(t, "9mm Cook-off");
    ArrayPush(t, "AO-Ammo-CookOff-Desc"); ArrayPush(t, "Reactive filler in the core. Drop someone and everything on their belt goes off with them, so step back. Works on your belt too, if you're holding a live one.\n\nA kill sets off a blast at the body that hurts everyone close by. A hit on you sets off your own grenade if it's charged.");
    ArrayPush(t, "AO-Ammo-9mm-Reloads"); ArrayPush(t, "9mm Reloads [Scav]");
    ArrayPush(t, "AO-Ammo-Reloads-Desc"); ArrayPush(t, "Brass picked up off the floor after other people's fights, a dozen makers in one bag, resized on a hand press and charged by eye. Some cases got half a scoop of powder and some got two.\n\nDamage varies -30% to +15%. 8% are duds that hit for a quarter. 5% run hot and hit for +50%.");
    ArrayPush(t, "AO-Ammo-9mm-GutterLead"); ArrayPush(t, "9mm Gutter Lead [Scav]");
    ArrayPush(t, "AO-Ammo-GutterLead-Desc"); ArrayPush(t, "Soft lead cast in a ladle from wheel weights and old pipe, no jacket on it and no sizing. A lumpy bullet like that tears on the way in, and lead that dirty poisons the wound it leaves.\n\n25% chance to cause bleeding. 25% chance to poison. -50% damage. Damage swings wide, with duds and hot rounds.");
    ArrayPush(t, "AO-Ammo-9mm-Shinobi"); ArrayPush(t, "9mm Shinobi [Ara]");
    ArrayPush(t, "AO-Ammo-Shinobi-Desc"); ArrayPush(t, "A heavy bullet loaded slow, under the speed of sound, with a soft nose that flattens on bone. Arasaka's close protection carry it for work indoors, where the shot has to stay in the room and the first one has to do the job.\n\nSilent kills. +50% headshot damage. -10% range.");
    ArrayPush(t, "AO-Ammo-9mm-ShinobiSeconds"); ArrayPush(t, "9mm Shinobi Seconds [Tyger]");
    ArrayPush(t, "AO-Ammo-ShinobiSeconds-Desc"); ArrayPush(t, "Shinobi knockoffs from a Kabuki back room: the same heavy bullet and slow load, with primers from whoever had them cheap that week. The shot is as quiet as the real thing. The primer doesn't always light all the powder.\n\nKills don't alert anyone nearby. -15% damage. 5% are duds that hit for a quarter.");
    ArrayPush(t, "AO-Ammo-9mm-Tanto"); ArrayPush(t, "9mm Tanto [Tyger]");
    ArrayPush(t, "AO-Ammo-Tanto-Desc"); ArrayPush(t, "A Tyger bench files four shallow grooves into each jacket before loading, the way they'd notch a blade. The grooves peel back on impact into edges, so the bullet cuts instead of pushing and the wound keeps bleeding.\n\n25% chance to cause bleeding. +10% crit chance.");
    ArrayPush(t, "AO-Ammo-9mm-Surplus"); ArrayPush(t, "9mm Surplus [6th]");
    ArrayPush(t, "AO-Ammo-Surplus-Desc"); ArrayPush(t, "Military ball from the Unification War, bought by the pallet when the depots sold off. 6th Street keep it in sealed cans in a dry garage. A full metal jacket over a mild charge, and every round in the can from the same lot.\n\nDamage varies only 5% either way. -10% recoil.");
    ArrayPush(t, "AO-Ammo-9mm-FourthOfJuly"); ArrayPush(t, "9mm Fourth of July [6th]");
    ArrayPush(t, "AO-Ammo-FourthOfJuly-Desc"); ArrayPush(t, "A spotting round with a marker chip in the nose and a pinch of flash compound behind it. Whoever it hits shows on your optics for a few seconds, and the compound sometimes catches on clothing. 6th Street use them to call targets.\n\nHits tag targets through walls for 5 seconds. 10% chance to set the target on fire.");
    ArrayPush(t, "AO-Ammo-9mm-MilSpec"); ArrayPush(t, "9mm Mil-Spec [Mil]");
    ArrayPush(t, "AO-Ammo-MilSpec-Desc"); ArrayPush(t, "Militech contract production, lot numbered on every case and slug and loaded to a moderate charge for control. Each lot is pressure tested and shot for group before anyone signs for it, and the hardened core gets some way into a vest.\n\nDamage varies only 5% either way. 25% armor penetration. -15% recoil.");
    ArrayPush(t, "AO-Ammo-9mm-DogtownTax"); ArrayPush(t, "9mm Dogtown Tax [Barghest]");
    ArrayPush(t, "AO-Ammo-DogtownTax-Desc"); ArrayPush(t, "Everybody in Dogtown pays Hansen. This is plain ball out of his stockpile, Barghest mark on the base, sold under the counter at the market. Drop someone with one and there's eddies on the body.\n\nKills leave eddies on the body.");
    ArrayPush(t, "AO-Ammo-9mm-WasteNot"); ArrayPush(t, "9mm Waste Not [Nomad]");
    ArrayPush(t, "AO-Ammo-WasteNot-Desc"); ArrayPush(t, "Aldecaldo handloads off a press bolted to a truck bed: cases picked up after every fight and run until the mouths split, powder weighed to the grain because the clan has to buy it. A box lasts longer than the lid count says.\n\n15% of shots don't use a round.");
    ArrayPush(t, "AO-Ammo-9mm-CutOff"); ArrayPush(t, "9mm Cut Off [Mox]");
    ArrayPush(t, "AO-Ammo-CutOff-Desc"); ArrayPush(t, "Mox bouncers load these for the floor: a rubber nose, or rubber shot in the shell, over a gel pocket of sedative from Lizzie's back room. The hit stings, and the dose puts a fair few people down on the spot.\n\nNon-lethal. 15% chance per shot to knock the target out.");
    ArrayPush(t, "AO-Ammo-9mm-LastCall"); ArrayPush(t, "9mm Last Call [Mox]");
    ArrayPush(t, "AO-Ammo-LastCall-Desc"); ArrayPush(t, "Under a thin jacket, a capsule of the knockout drug Mox bartenders keep for a troublemaker's last drink. It breaks in the wound and the drug needs a few seconds to reach the brain, so the target keeps walking about that long.\n\n15% chance per shot to drop the target unconscious 4 seconds later.");
    ArrayPush(t, "AO-Ammo-9mm-StandardIssue"); ArrayPush(t, "9mm Standard Issue [NCPD]");
    ArrayPush(t, "AO-Ammo-StandardIssue-Desc"); ArrayPush(t, "NCPD duty ammunition, bought by the million from the lowest bidder. A jacketed bullet over a charge that burns the same way every time, so a long string of shots keeps landing near the first one instead of walking off the target.\n\nHold the trigger and shots stay tight instead of spreading.");
    ArrayPush(t, "AO-Ammo-9mm-ResistingArrest"); ArrayPush(t, "9mm Resisting Arrest [NCPD]");
    ArrayPush(t, "AO-Ammo-ResistingArrest-Desc"); ArrayPush(t, "NCPD duty loads with a charged capacitor and a pair of needle contacts up front, for suspects who run. The needles seat on a solid hit and the capacitor dumps into the target, which locks their muscles for a few seconds.\n\n20% chance per shot to shock the target.");
    ArrayPush(t, "AO-Ammo-45-SteelCore"); ArrayPush(t, ".45 Steel-Core");
    ArrayPush(t, "AO-Ammo-45-Incendiary"); ArrayPush(t, ".45 Incendiary");
    ArrayPush(t, "AO-Ammo-Incendiary-Desc"); ArrayPush(t, "A pinch of incendiary mix in the tip. It flashes when it hits and can set the target alight.\n\n15% chance to set the target on fire. A quarter of the damage is fire damage. -5% damage.");
    ArrayPush(t, "AO-Ammo-45-Subsonic"); ArrayPush(t, ".45 Subsonic");
    ArrayPush(t, "AO-Ammo-45-Bouncers"); ArrayPush(t, ".45 Bouncers");
    ArrayPush(t, "AO-Ammo-45-Rubber"); ArrayPush(t, ".45 Rubber");
    ArrayPush(t, "AO-Ammo-45-Penetrator"); ArrayPush(t, ".45 Penetrator");
    ArrayPush(t, "AO-Ammo-45-Match"); ArrayPush(t, ".45 Match");
    ArrayPush(t, "AO-Ammo-45-Toxin"); ArrayPush(t, ".45 Toxin Core");
    ArrayPush(t, "AO-Ammo-45-Shredders"); ArrayPush(t, ".45 Shredders");
    ArrayPush(t, "AO-Ammo-45-CookOff"); ArrayPush(t, ".45 Cook-off");
    ArrayPush(t, "AO-Ammo-45-Redliners"); ArrayPush(t, ".45 Redliners [Mael]");
    ArrayPush(t, "AO-Ammo-Redliners-Desc"); ArrayPush(t, "Maelstrom load these hot, a few grains of powder over the book maximum, so the gun cycles faster than it was built to. The brass comes out stretched, and now and then a case sticks and the gun locks up.\n\n+25% fire rate. +40% recoil and spread. 2% chance per shot to jam your weapons for 3 seconds.");
    ArrayPush(t, "AO-Ammo-45-MeatGrinders"); ArrayPush(t, ".45 Meat-grinders [Mael]");
    ArrayPush(t, "AO-Ammo-MeatGrinders-Desc"); ArrayPush(t, "The bullet, or every pellet in the shell, gets a few passes on a bench grinder until the jacket is all teeth. It opens wide the moment it hits meat and leaves a wound that won't close. Limbs come off easier.\n\n30% chance to cause bleeding. Three times the dismemberment chance.");
    ArrayPush(t, "AO-Ammo-45-Reloads"); ArrayPush(t, ".45 Reloads [Scav]");
    ArrayPush(t, "AO-Ammo-45-GutterLead"); ArrayPush(t, ".45 Gutter Lead [Scav]");
    ArrayPush(t, "AO-Ammo-45-PartsPullers"); ArrayPush(t, ".45 Parts-pullers [Scav]");
    ArrayPush(t, "AO-Ammo-PartsPullers-Desc"); ArrayPush(t, "Loaded soft, with a light hollow nose bullet that stops inside the body and doesn't wreck the chrome behind it. Scavs use them when they want the body stripped afterward, and a ripper pays for what comes out.\n\nA kill leaves 2 Rare crafting components on the body. Damage swings wide, with duds and hot rounds.");
    ArrayPush(t, "AO-Ammo-45-Kata"); ArrayPush(t, ".45 Kata [Ara]");
    ArrayPush(t, "AO-Ammo-Kata-Desc"); ArrayPush(t, "Every round in this box weighs what the last one did. Arasaka make them in one plant to one recipe, and the charge sits a little under full, so the gun kicks less and comes back onto the sights quicker.\n\nDamage varies only -1% to +1%. 30% less recoil. 30% faster aim.");
    ArrayPush(t, "AO-Ammo-45-Shinobi"); ArrayPush(t, ".45 Shinobi [Ara]");
    ArrayPush(t, "AO-Ammo-45-ShinobiSeconds"); ArrayPush(t, ".45 Shinobi Seconds [Tyger]");
    ArrayPush(t, "AO-Ammo-45-Tanto"); ArrayPush(t, ".45 Tanto [Tyger]");
    ArrayPush(t, "AO-Ammo-45-GoldTips"); ArrayPush(t, ".45 Gold Tips [Val]");
    ArrayPush(t, "AO-Ammo-GoldTips-Desc"); ArrayPush(t, "Valentinos press a cap of real gold over a hollow point nose and put a bit more powder behind it. The soft gold opens the jacket wide on a good hit, and it's why the box costs what it does.\n\n+15% crit chance. +30% crit damage. +20% recoil.");
    ArrayPush(t, "AO-Ammo-45-SantaMuerte"); ArrayPush(t, ".45 Santa Muerte [Val]");
    ArrayPush(t, "AO-Ammo-SantaMuerte-Desc"); ArrayPush(t, "A hollow point with incendiary mix in the cavity and a small skull stamped on the base. Valentinos have each box blessed at a Santa Muerte altar before it leaves Heywood. Put one through a skull and the mix lights off.\n\n+50% headshot damage. Headshots set the target on fire.");
    ArrayPush(t, "AO-Ammo-45-Surplus"); ArrayPush(t, ".45 Surplus [6th]");
    ArrayPush(t, "AO-Ammo-45-BadJuju"); ArrayPush(t, ".45 Bad Juju [VDB]");
    ArrayPush(t, "AO-Ammo-BadJuju-Desc"); ArrayPush(t, "Voodoo Boys set a flash chip in a hollow nose with a line of their code on it. It shorts against the target's implants on impact and the code gets in through the breach. For a while after, the target can't tell friend from enemy.\n\n15% chance per shot to turn the target on its friends for 20 seconds.");
    ArrayPush(t, "AO-Ammo-45-PocketSand"); ArrayPush(t, ".45 Pocket Sand [Wraith]");
    ArrayPush(t, "AO-Ammo-PocketSand-Desc"); ArrayPush(t, "Wraiths pack a spoonful of fine Badlands sand between the powder and the bullet, or over the shot in a shell. A hit throws the sand in the target's face, and for a second or two they can't see.\n\n20% chance per shot to blind the target for 2 seconds.");
    ArrayPush(t, "AO-Ammo-45-WasteNot"); ArrayPush(t, ".45 Waste Not [Nomad]");
    ArrayPush(t, "AO-Ammo-45-Speedloaders"); ArrayPush(t, ".45 Speedloaders [Nomad]");
    ArrayPush(t, "AO-Ammo-Speedloaders-Desc"); ArrayPush(t, "These come with the clan's own magazine springs and slick followers. Aldecaldos top the mag off before the gun goes back on the hip, every time, by feel. Pull it and it's full.\n\nDraw the gun and the magazine's full, however you left it.");
    ArrayPush(t, "AO-Ammo-45-CutOff"); ArrayPush(t, ".45 Cut Off [Mox]");
    ArrayPush(t, "AO-Ammo-45-StandardIssue"); ArrayPush(t, ".45 Standard Issue [NCPD]");
    ArrayPush(t, "AO-Ammo-45-Deniable"); ArrayPush(t, ".45 Deniable [NUSA]");
    ArrayPush(t, "AO-Ammo-Deniable-Desc"); ArrayPush(t, "A heavy projectile loaded slow and quiet, in a case with no headstamp. The plant that makes them for the NUSA prints no lot number and ships them in blank boxes. Built for one shot at someone who hasn't turned around yet.\n\nSilent kills. Double damage on targets who haven't seen you.");
    ArrayPush(t, "AO-Ammo-12mm-SteelCore"); ArrayPush(t, "12mm Steel-Core");
    ArrayPush(t, "AO-Ammo-12mm-Incendiary"); ArrayPush(t, "12mm Incendiary");
    ArrayPush(t, "AO-Ammo-12mm-Rubber"); ArrayPush(t, "12mm Rubber");
    ArrayPush(t, "AO-Ammo-12mm-Hardcast"); ArrayPush(t, "12mm Hardcast");
    ArrayPush(t, "AO-Ammo-Hardcast-Desc"); ArrayPush(t, "Hard-cast lead with a flat nose, loaded heavy. It shoves people back a step and gets a little way into armor, but it kicks.\n\n25% chance to stagger. Ignores 10% of armor. +20% recoil.");
    ArrayPush(t, "AO-Ammo-12mm-Penetrator"); ArrayPush(t, "12mm Penetrator");
    ArrayPush(t, "AO-Ammo-12mm-Penetrator-Desc"); ArrayPush(t, "Tungsten-core rounds. They punch through armor and thin cover.\n\nIgnores 60% of armor. Goes through thin cover at half damage.");
    ArrayPush(t, "AO-Ammo-12mm-Match"); ArrayPush(t, "12mm Match");
    ArrayPush(t, "AO-Ammo-12mm-Toxin"); ArrayPush(t, "12mm Toxin Core");
    ArrayPush(t, "AO-Ammo-12mm-Shredders"); ArrayPush(t, "12mm Shredders");
    ArrayPush(t, "AO-Ammo-12mm-CookOff"); ArrayPush(t, "12mm Cook-off");
    ArrayPush(t, "AO-Ammo-12mm-MeatGrinders"); ArrayPush(t, "12mm Meat-grinders [Mael]");
    ArrayPush(t, "AO-Ammo-12mm-Reloads"); ArrayPush(t, "12mm Reloads [Scav]");
    ArrayPush(t, "AO-Ammo-12mm-GutterLead"); ArrayPush(t, "12mm Gutter Lead [Scav]");
    ArrayPush(t, "AO-Ammo-12mm-PartsPullers"); ArrayPush(t, "12mm Parts-pullers [Scav]");
    ArrayPush(t, "AO-Ammo-12mm-Tanto"); ArrayPush(t, "12mm Tanto [Tyger]");
    ArrayPush(t, "AO-Ammo-12mm-GoldTips"); ArrayPush(t, "12mm Gold Tips [Val]");
    ArrayPush(t, "AO-Ammo-12mm-SantaMuerte"); ArrayPush(t, "12mm Santa Muerte [Val]");
    ArrayPush(t, "AO-Ammo-12mm-Surplus"); ArrayPush(t, "12mm Surplus [6th]");
    ArrayPush(t, "AO-Ammo-12mm-FourthOfJuly"); ArrayPush(t, "12mm Fourth of July [6th]");
    ArrayPush(t, "AO-Ammo-12mm-ProteinLoads"); ArrayPush(t, "12mm Protein Loads [Animal]");
    ArrayPush(t, "AO-Ammo-ProteinLoads-Desc"); ArrayPush(t, "Flat nosed bullets and rail slugs sold out of an Animals gym in Pacifica, next to the protein tubs. Drop someone with one and you get a rush off it. Legs and hands move quicker for a few seconds, and it builds.\n\nKills give +6% move speed and 10% faster reloads for 10 seconds, stacking 3 times.");
    ArrayPush(t, "AO-Ammo-12mm-LegDay"); ArrayPush(t, "12mm Leg Day [Animal]");
    ArrayPush(t, "AO-Ammo-LegDay-Desc"); ArrayPush(t, "The Animals had these made for their Buryas and Novas: a big slug behind a stiff charge, and the kick to match. Put one into someone and there's a fair chance a leg goes. They stay put and shoot from there.\n\n20% chance per shot to cripple the target's legs. +80% recoil.");
    ArrayPush(t, "AO-Ammo-12mm-WasteNot"); ArrayPush(t, "12mm Waste Not [Nomad]");
    ArrayPush(t, "AO-Ammo-12mm-Speedloaders"); ArrayPush(t, "12mm Speedloaders [Nomad]");
    ArrayPush(t, "AO-Ammo-12mm-LastCall"); ArrayPush(t, "12mm Last Call [Mox]");
    ArrayPush(t, "AO-Ammo-556-SteelCore"); ArrayPush(t, "5.56 Steel-Core");
    ArrayPush(t, "AO-Ammo-556-Incendiary"); ArrayPush(t, "5.56 Incendiary");
    ArrayPush(t, "AO-Ammo-556-Subsonic"); ArrayPush(t, "5.56 Subsonic");
    ArrayPush(t, "AO-Ammo-556-Bouncers"); ArrayPush(t, "5.56 Bouncers");
    ArrayPush(t, "AO-Ammo-556-Penetrator"); ArrayPush(t, "5.56 Penetrator");
    ArrayPush(t, "AO-Ammo-556-Match"); ArrayPush(t, "5.56 Match");
    ArrayPush(t, "AO-Ammo-556-Toxin"); ArrayPush(t, "5.56 Toxin Core");
    ArrayPush(t, "AO-Ammo-556-Shredders"); ArrayPush(t, "5.56 Shredders");
    ArrayPush(t, "AO-Ammo-556-CookOff"); ArrayPush(t, "5.56 Cook-off");
    ArrayPush(t, "AO-Ammo-556-Redliners"); ArrayPush(t, "5.56 Redliners [Mael]");
    ArrayPush(t, "AO-Ammo-556-Kata"); ArrayPush(t, "5.56 Kata [Ara]");
    ArrayPush(t, "AO-Ammo-556-DogtownTax"); ArrayPush(t, "5.56 Dogtown Tax [Barghest]");
    ArrayPush(t, "AO-Ammo-762-SteelCore"); ArrayPush(t, "7.62 Steel-Core");
    ArrayPush(t, "AO-Ammo-762-Incendiary"); ArrayPush(t, "7.62 Incendiary");
    ArrayPush(t, "AO-Ammo-762-BallisticTip"); ArrayPush(t, "7.62 Ballistic Tip");
    ArrayPush(t, "AO-Ammo-BallisticTip-Desc"); ArrayPush(t, "Polymer-tipped hunting rounds. They fly flatter and hit a little harder, but they break up on armor.\n\n+40% range. +5% damage. Armor is 10% more effective against it.");
    ArrayPush(t, "AO-Ammo-762-Ping"); ArrayPush(t, "7.62 Ping");
    ArrayPush(t, "AO-Ammo-Ping-Desc"); ArrayPush(t, "Rounds with a tag chip in the nose. Whatever they hit shows up on your optics for a few seconds, through walls.\n\nTargets hit show through walls for 5 seconds. -10% damage.");
    ArrayPush(t, "AO-Ammo-762-Penetrator"); ArrayPush(t, "7.62 Penetrator");
    ArrayPush(t, "AO-Ammo-762-Penetrator-Desc"); ArrayPush(t, "Tungsten-core rounds. They punch through armor and thin cover.\n\nIgnores 60% of armor. Goes through thin cover at half damage.");
    ArrayPush(t, "AO-Ammo-762-Match"); ArrayPush(t, "7.62 Match");
    ArrayPush(t, "AO-Ammo-762-Toxin"); ArrayPush(t, "7.62 Toxin Core");
    ArrayPush(t, "AO-Ammo-762-Shredders"); ArrayPush(t, "7.62 Shredders");
    ArrayPush(t, "AO-Ammo-762-Gatecrasher"); ArrayPush(t, "7.62 Gatecrasher");
    ArrayPush(t, "AO-Ammo-Gatecrasher-Desc"); ArrayPush(t, "Solid tungsten penetrators. Arasaka spends a fortune on their guards' plating and this round couldn't care less.\n\nIgnores all armor. No damage falloff. Goes through cover at full damage.");
    ArrayPush(t, "AO-Ammo-762-CookOff"); ArrayPush(t, "7.62 Cook-off");
    ArrayPush(t, "AO-Ammo-762-Redliners"); ArrayPush(t, "7.62 Redliners [Mael]");
    ArrayPush(t, "AO-Ammo-762-Kata"); ArrayPush(t, "7.62 Kata [Ara]");
    ArrayPush(t, "AO-Ammo-762-MilSpec"); ArrayPush(t, "7.62 Mil-Spec [Mil]");
    ArrayPush(t, "AO-Ammo-762-CeaseAndDesist"); ArrayPush(t, "7.62 Cease and Desist [Mil]");
    ArrayPush(t, "AO-Ammo-CeaseAndDesist-Desc"); ArrayPush(t, "Blunt, heavy projectiles loaded a touch light, so they dump their weight into the target at once. They get through a vest and shove most people off their feet for a moment. Militech issue for when someone's wanted alive.\n\n30% chance per shot to stagger the target. 50% armor penetration. -10% damage.");
    ArrayPush(t, "AO-Ammo-762-ChimeraScrap"); ArrayPush(t, "7.62 Chimera Scrap [Barghest]");
    ArrayPush(t, "AO-Ammo-ChimeraScrap-Desc"); ArrayPush(t, "The explosive in these came out of the wrecked Chimera, the shells it carried and the reactive plating both. Barghest armorers pack it into a hollow bullet or slug, and each one goes off when it hits.\n\nBullets explode on impact.");
    ArrayPush(t, "AO-Ammo-127-SteelCore"); ArrayPush(t, "12.7 Steel-Core");
    ArrayPush(t, "AO-Ammo-127-Incendiary"); ArrayPush(t, "12.7 Incendiary");
    ArrayPush(t, "AO-Ammo-127-BallisticTip"); ArrayPush(t, "12.7 Ballistic Tip");
    ArrayPush(t, "AO-Ammo-127-Ping"); ArrayPush(t, "12.7 Ping");
    ArrayPush(t, "AO-Ammo-127-Penetrator"); ArrayPush(t, "12.7 Penetrator");
    ArrayPush(t, "AO-Ammo-127-Penetrator-Desc"); ArrayPush(t, "Tungsten-core rounds. They punch through armor and thin cover.\n\nIgnores 60% of armor. Goes through thin cover at half damage.");
    ArrayPush(t, "AO-Ammo-127-Match"); ArrayPush(t, "12.7 Match");
    ArrayPush(t, "AO-Ammo-127-Toxin"); ArrayPush(t, "12.7 Toxin Core");
    ArrayPush(t, "AO-Ammo-127-HEI"); ArrayPush(t, "12.7 HEI");
    ArrayPush(t, "AO-Ammo-HEI-Desc"); ArrayPush(t, "High-explosive incendiary. A small charge in the nose goes off on impact. It tears up drones, mechs and cars, and can set people alight. No splash.\n\n+50% damage against drones, mechs and vehicles. 20% chance to set the target on fire.");
    ArrayPush(t, "AO-Ammo-127-Gatecrasher"); ArrayPush(t, "12.7 Gatecrasher");
    ArrayPush(t, "AO-Ammo-127-BlackBudget"); ArrayPush(t, "12.7 Black Budget [NUSA]");
    ArrayPush(t, "AO-Ammo-BlackBudget-Desc"); ArrayPush(t, "The hollow in this round holds a military toxin from a program the NUSA stopped admitting to years ago. It takes a fair dose to do the job, which is why it only comes in the big calibers.\n\n30% chance per shot to badly poison the target.");
    ArrayPush(t, "AO-Ammo-12ga-Flechette"); ArrayPush(t, "Flechettes");
    ArrayPush(t, "AO-Ammo-Flechette-Desc"); ArrayPush(t, "Steel darts instead of shot. They keep together and keep going, but each one hits lighter.\n\nTighter spread. Double range. -15% damage.");
    ArrayPush(t, "AO-Ammo-12ga-Beanbag"); ArrayPush(t, "Beanbags");
    ArrayPush(t, "AO-Ammo-Beanbag-Desc"); ArrayPush(t, "A cloth bag of lead shot. Puts people on the ground without putting them in it.\n\nFires one projectile with the whole shot's damage. Knocks targets down. Non-lethal: targets go down unconscious instead of dying. -50% damage.");
    ArrayPush(t, "AO-Ammo-12ga-DragonLight"); ArrayPush(t, "Dragon's Breath Lite");
    ArrayPush(t, "AO-Ammo-DragonLight-Desc"); ArrayPush(t, "Magnesium pellets mixed in with the shot. A short gout of sparks that can set people alight.\n\n30% chance to set the target on fire. Half the damage is fire damage. -20% range.");
    ArrayPush(t, "AO-Ammo-12ga-Dragon"); ArrayPush(t, "Dragon's Breath");
    ArrayPush(t, "AO-Ammo-Dragon-Desc"); ArrayPush(t, "A full load of magnesium pellets. The shot comes out as a sheet of fire.\n\nAll damage is fire damage. 60% chance to set the target badly on fire.");
    ArrayPush(t, "AO-Ammo-12ga-Frag12"); ArrayPush(t, "Frag-12");
    ArrayPush(t, "AO-Ammo-Frag12-Desc"); ArrayPush(t, "A fin-stabilized slug with a shaped charge in the nose. Punches through armor and tears up machines. No splash.\n\nFires one projectile with the whole shot's damage. Ignores 50% of armor. +50% damage against drones, mechs and vehicles.");
    ArrayPush(t, "AO-Ammo-12ga-FlechetteLong"); ArrayPush(t, "Long Flechettes");
    ArrayPush(t, "AO-Ammo-FlechetteLong-Desc"); ArrayPush(t, "Long tungsten darts. They stay in a tight group and still hit hard well past where buckshot gives up.\n\nTighter spread. 3.5x range.");
    ArrayPush(t, "AO-Ammo-12ga-PumpNDump"); ArrayPush(t, "Pump N Dump");
    ArrayPush(t, "AO-Ammo-PumpNDump-Desc"); ArrayPush(t, "Greased hulls that slide in as fast as you can pump. Finishes quick, leaves a mess, and your wallet feels used afterward.\n\nOne slug per shot with the whole shot's damage. Tight spread. 2.5 times the fire rate. Burns through ammo fast.");
    ArrayPush(t, "AO-Ammo-12ga-MeatGrinders"); ArrayPush(t, "Meat-grinders [Mael]");
    ArrayPush(t, "AO-Ammo-12ga-CeaseAndDesist"); ArrayPush(t, "Cease and Desist [Mil]");
    ArrayPush(t, "AO-Ammo-12ga-PocketSand"); ArrayPush(t, "Pocket Sand [Wraith]");
    ArrayPush(t, "AO-Ammo-12ga-CutOff"); ArrayPush(t, "Cut Off [Mox]");
    ArrayPush(t, "AO-Ammo-12ga-ResistingArrest"); ArrayPush(t, "Resisting Arrest [NCPD]");
    ArrayPush(t, "AO-Ammo-4ga-Flechette"); ArrayPush(t, "4ga Flechettes");
    ArrayPush(t, "AO-Ammo-4ga-Riot"); ArrayPush(t, "4ga Riot");
    ArrayPush(t, "AO-Ammo-Riot-Desc"); ArrayPush(t, "A big rubber baton round for the Carnage. Flattens whoever it hits, and they usually get back up later.\n\nFires one projectile with the whole shot's damage. Knocks targets down. Non-lethal: targets go down unconscious instead of dying. -50% damage.");
    ArrayPush(t, "AO-Ammo-4ga-Flare"); ArrayPush(t, "4ga Flares");
    ArrayPush(t, "AO-Ammo-Flare-Desc"); ArrayPush(t, "A signal flare in a 4-gauge shell. Blinds whoever it hits and might set them alight.\n\nFires one projectile with the whole shot's damage. Blinds the target for a moment. 30% chance to set the target on fire.");
    ArrayPush(t, "AO-Ammo-4ga-Dragon"); ArrayPush(t, "4ga Dragon's Breath");
    ArrayPush(t, "AO-Ammo-4ga-Thermite"); ArrayPush(t, "4ga Thermite Slugs");
    ArrayPush(t, "AO-Ammo-Thermite-Desc"); ArrayPush(t, "A slug packed with thermite. It burns through plating and sets whoever it hits on fire.\n\nFires one projectile with the whole shot's damage. Sets the target badly on fire. Double damage against drones, mechs and vehicles.");
    ArrayPush(t, "AO-Ammo-4ga-MuleKick"); ArrayPush(t, "4ga Mule Kick");
    ArrayPush(t, "AO-Ammo-MuleKick-Desc"); ArrayPush(t, "4 gauge shells loaded past what any gun was built for. The target goes down, and you go backward. Fire at the floor if you want a lift.\n\nEvery hit knocks the target down; tough ones stagger. A hit on you knocks you down. Each shot shoves you hard away from your aim, so a shot at the floor takes you up.");
    ArrayPush(t, "AO-Ammo-4ga-MeatGrinders"); ArrayPush(t, "4ga Meat-grinders [Mael]");
    ArrayPush(t, "AO-Ammo-5mm-Ferro"); ArrayPush(t, "5mm Ferro");
    ArrayPush(t, "AO-Ammo-Ferro-Desc"); ArrayPush(t, "Hardened ferrous slugs that skip off hard surfaces instead of shattering.\n\n40% chance to ricochet, up to twice. -10% damage.");
    ArrayPush(t, "AO-Ammo-5mm-SplitSlug"); ArrayPush(t, "5mm Split Slugs");
    ArrayPush(t, "AO-Ammo-SplitSlug-Desc"); ArrayPush(t, "A slug scored to come apart in the rails. Three pieces leave the barrel and spread out. None of them go through walls.\n\nFires three projectiles that share the shot's damage. Wider spread. Doesn't pierce cover.");
    ArrayPush(t, "AO-Ammo-5mm-Feedback"); ArrayPush(t, "5mm Feedback");
    ArrayPush(t, "AO-Ammo-Feedback-Desc"); ArrayPush(t, "Slugs with a pickup coil that the gun's targeting can steer a little in flight.\n\nShots bend toward targets near the crosshair. -10% damage.");
    ArrayPush(t, "AO-Ammo-5mm-DUPen"); ArrayPush(t, "5mm DU Penetrator");
    ArrayPush(t, "AO-Ammo-DUPen-Desc"); ArrayPush(t, "Depleted uranium slugs. They go through cover at half charge and through armor at any charge.\n\nPierces cover at a lower charge. Loses half as much damage through cover. Ignores 50% of armor.");
    ArrayPush(t, "AO-Ammo-5mm-ToxicScatter"); ArrayPush(t, "5mm Toxic Scatter");
    ArrayPush(t, "AO-Ammo-ToxicScatter-Desc"); ArrayPush(t, "Five toxin-coated flechettes stacked in one sabot. They spread out and each one carries a dose.\n\nFires five projectiles that share the shot's damage. Wider spread. 25% chance to poison.");
    ArrayPush(t, "AO-Ammo-5mm-Superconductor"); ArrayPush(t, "5mm Superconductor");
    ArrayPush(t, "AO-Ammo-Superconductor-Desc"); ArrayPush(t, "Supercooled slugs that the rails can cycle as fast as they charge.\n\nFull auto at full charge.");
    ArrayPush(t, "AO-Ammo-5mm-EMPCap"); ArrayPush(t, "5mm EMP Capacitor");
    ArrayPush(t, "AO-Ammo-EMPCap-Desc"); ArrayPush(t, "A slug with a charged capacitor in the core. It dumps the charge into whatever it hits.\n\n30% chance of an EMP. 30% of the damage is electrical damage.");
    ArrayPush(t, "AO-Ammo-5mm-Kebab"); ArrayPush(t, "5mm Kebab");
    ArrayPush(t, "AO-Ammo-Kebab-Desc"); ArrayPush(t, "Long hardened slugs. Charge a shot and it goes through the first guy, the second guy, and the wall they were hiding behind.\n\nA charged shot goes through every body and wall in its line with no damage lost.");
    ArrayPush(t, "AO-Ammo-5mm-ChromeCookers"); ArrayPush(t, "5mm Chrome-cookers [Mael]");
    ArrayPush(t, "AO-Ammo-ChromeCookers-Desc"); ArrayPush(t, "Ask Maelstrom why there's scrap wire round the slug and they'll say the rails put a charge in it. True or not, a hit knocks the target's chrome out now and then. Less lead, so it hits a bit softer.\n\n15% chance of a cyberware malfunction. -10% damage.");
    ArrayPush(t, "AO-Ammo-5mm-Kata"); ArrayPush(t, "5mm Kata [Ara]");
    ArrayPush(t, "AO-Ammo-5mm-MilSpec"); ArrayPush(t, "5mm Mil-Spec [Mil]");
    ArrayPush(t, "AO-Ammo-5mm-ProteinLoads"); ArrayPush(t, "5mm Protein Loads [Animal]");
    ArrayPush(t, "AO-Ammo-5mm-ChimeraScrap"); ArrayPush(t, "5mm Chimera Scrap [Barghest]");
    ArrayPush(t, "AO-Ammo-5mm-BadJuju"); ArrayPush(t, "5mm Bad Juju [VDB]");
    ArrayPush(t, "AO-Ammo-5mm-CollectCall"); ArrayPush(t, "5mm Collect Call [VDB]");
    ArrayPush(t, "AO-Ammo-CollectCall-Desc"); ArrayPush(t, "The chip in the nose is a relay, and the number it dials is on the far side of the Blackwall. Brigitte's people won't say what picks up. The ones who took the call aren't in any shape to describe it.\n\n10% chance per shot to kill the target outright. Please hold.");
    ArrayPush(t, "AO-Ammo-5mm-TheClap"); ArrayPush(t, "5mm The Clap [Wraith]");
    ArrayPush(t, "AO-Ammo-TheClap-Desc"); ArrayPush(t, "Rail slugs dipped in whatever has been breeding in a Wraith camp's water barrel and sealed under wax. The wax comes off in the rails and the slug carries the culture into the wound, and anyone standing next to the target breathes some of it.\n\n20% chance per shot to poison the target. It spreads to whoever's close.");
    ArrayPush(t, "AO-Ammo-5mm-Deniable"); ArrayPush(t, "5mm Deniable [NUSA]");
    ArrayPush(t, "AO-Ammo-Heavy-Ferro"); ArrayPush(t, "Heavy Ferro");
    ArrayPush(t, "AO-Ammo-Heavy-SplitSlug"); ArrayPush(t, "Heavy Split Slugs");
    ArrayPush(t, "AO-Ammo-Heavy-Feedback"); ArrayPush(t, "Heavy Feedback");
    ArrayPush(t, "AO-Ammo-Heavy-DUPen"); ArrayPush(t, "Heavy DU Penetrator");
    ArrayPush(t, "AO-Ammo-Heavy-ToxicScatter"); ArrayPush(t, "Heavy Toxic Scatter");
    ArrayPush(t, "AO-Ammo-Heavy-Superconductor"); ArrayPush(t, "Heavy Superconductor");
    ArrayPush(t, "AO-Ammo-Heavy-EMPCap"); ArrayPush(t, "Heavy EMP Capacitor");
    ArrayPush(t, "AO-Ammo-Heavy-Kebab"); ArrayPush(t, "Heavy Kebab");
    ArrayPush(t, "AO-Ammo-Heavy-ChromeCookers"); ArrayPush(t, "Heavy Chrome-cookers [Mael]");
    ArrayPush(t, "AO-Ammo-Heavy-ProteinLoads"); ArrayPush(t, "Heavy Protein Loads [Animal]");
    ArrayPush(t, "AO-Ammo-Heavy-LegDay"); ArrayPush(t, "Heavy Leg Day [Animal]");
    ArrayPush(t, "AO-Ammo-Heavy-TheClap"); ArrayPush(t, "Heavy The Clap [Wraith]");
    ArrayPush(t, "AO-Ammo-Heavy-BlackBudget"); ArrayPush(t, "Heavy Black Budget [NUSA]");
    ArrayPush(t, "AO-Ammo-10mm-EMPPayload"); ArrayPush(t, "10mm EMP Payload");
    ArrayPush(t, "AO-Ammo-EMPPayload-Desc"); ArrayPush(t, "Smart rounds with an EMP charge in place of some of the explosive.\n\n25% chance of an EMP. 30% of the damage is electrical damage. -10% damage.");
    ArrayPush(t, "AO-Ammo-10mm-FirePayload"); ArrayPush(t, "10mm Incendiary Payload");
    ArrayPush(t, "AO-Ammo-FirePayload-Desc"); ArrayPush(t, "Smart rounds with an incendiary filler.\n\n25% chance to set the target on fire. 30% of the damage is fire damage. -10% damage.");
    ArrayPush(t, "AO-Ammo-10mm-ChemPayload"); ArrayPush(t, "10mm Chem Payload");
    ArrayPush(t, "AO-Ammo-ChemPayload-Desc"); ArrayPush(t, "Smart rounds carrying a toxin capsule.\n\n25% chance to poison. 30% of the damage is chemical damage. -10% damage.");
    ArrayPush(t, "AO-Ammo-10mm-FlashPayload"); ArrayPush(t, "10mm Flash Payload");
    ArrayPush(t, "AO-Ammo-FlashPayload-Desc"); ArrayPush(t, "Smart rounds with a flash charge. Less bang, a lot more light.\n\n30% chance to blind the target. -20% damage.");
    ArrayPush(t, "AO-Ammo-10mm-Hunter"); ArrayPush(t, "10mm Hunter");
    ArrayPush(t, "AO-Ammo-Hunter-Desc"); ArrayPush(t, "Smart rounds with a better seeker head and a faster motor.\n\nLocks two more targets. Locks on twice as fast. +20% hit chance. Rounds fly 30% faster.");
    ArrayPush(t, "AO-Ammo-10mm-HackCarrier"); ArrayPush(t, "10mm Hack Carrier");
    ArrayPush(t, "AO-Ammo-HackCarrier-Desc"); ArrayPush(t, "Smart rounds that push malware through the target's link when they hit.\n\n15% chance of a cyberware malfunction. 15% chance to jam the target's weapon.");
    ArrayPush(t, "AO-Ammo-10mm-ShapedCharge"); ArrayPush(t, "10mm Shaped Charge");
    ArrayPush(t, "AO-Ammo-ShapedCharge-Desc"); ArrayPush(t, "Smart rounds with a shaped-charge warhead. Built for armor and machines.\n\nIgnores 50% of armor. +50% damage against drones, mechs and vehicles.");
    ArrayPush(t, "AO-Ammo-10mm-Lockout"); ArrayPush(t, "10mm Lockout");
    ArrayPush(t, "AO-Ammo-Lockout-Desc"); ArrayPush(t, "Smart rounds that talk to the target's gun on arrival. The gun listens, and whoever's holding it spends four seconds very confused.\n\nEvery hit jams the target's weapon for 4 seconds.");
    ArrayPush(t, "AO-Ammo-10mm-Kansatsu"); ArrayPush(t, "10mm Kansatsu [Ara]");
    ArrayPush(t, "AO-Ammo-Kansatsu-Desc"); ArrayPush(t, "An Arasaka surveillance chip sits behind the seeker head. It stays in whoever it hits and feeds their position to your optics through walls, and the seeker locks on in about half the time a stock one takes.\n\nTargets hit show through walls for 5 seconds. Locks on twice as fast.");
    ArrayPush(t, "AO-Ammo-10mm-FourthOfJuly"); ArrayPush(t, "10mm Fourth of July [6th]");
    ArrayPush(t, "AO-Ammo-10mm-BadJuju"); ArrayPush(t, "10mm Bad Juju [VDB]");
    ArrayPush(t, "AO-Ammo-10mm-CollectCall"); ArrayPush(t, "10mm Collect Call [VDB]");
    ArrayPush(t, "AO-Ammo-10mm-WideAngle"); ArrayPush(t, "10mm Wide Angle [Kang]");
    ArrayPush(t, "AO-Ammo-WideAngle-Desc"); ArrayPush(t, "Kang Tao seeker heads with a wide lens in place of the stock narrow one, so the round picks up and locks a target well off to the side of where the barrel points.\n\nLocks on to targets much further from the crosshair.");
    ArrayPush(t, "AO-Ammo-10mm-SecondOpinion"); ArrayPush(t, "10mm Second Opinion [Kang]");
    ArrayPush(t, "AO-Ammo-SecondOpinion-Desc"); ArrayPush(t, "There's a short range link between these Kang Tao seekers, so each round in the air shares what it sees with the ones behind it and the gun can hold two more locks at once.\n\nLocks on to 2 more targets at once.");
    ArrayPush(t, "AO-Ammo-10mm-Deniable"); ArrayPush(t, "10mm Deniable [NUSA]");
    ArrayPush(t, "AO-Ammo-10mm-HackOptics1"); ArrayPush(t, "10mm Reboot Optics [Hack]");
    ArrayPush(t, "AO-Ammo-HackOptics1-Desc"); ArrayPush(t, "Reboot Optics, burned onto the seeker chip. On a hit the round pushes the program through the target's implant link and their optics drop to a boot screen for a few seconds.\n\n10% chance per shot to blind the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackOptics2"); ArrayPush(t, "10mm Reboot Optics [Hack]");
    ArrayPush(t, "AO-Ammo-HackOptics2-Desc"); ArrayPush(t, "Reboot Optics, burned onto the seeker chip. On a hit the round pushes the program through the target's implant link and their optics drop to a boot screen for a few seconds.\n\n15% chance per shot to blind the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackOptics3"); ArrayPush(t, "10mm Reboot Optics [Hack]");
    ArrayPush(t, "AO-Ammo-HackOptics3-Desc"); ArrayPush(t, "Reboot Optics, burned onto the seeker chip. On a hit the round pushes the program through the target's implant link and their optics drop to a boot screen for a few seconds.\n\n20% chance per shot to blind the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackOptics4"); ArrayPush(t, "10mm Reboot Optics [Hack]");
    ArrayPush(t, "AO-Ammo-HackOptics4-Desc"); ArrayPush(t, "The target's optics shut down and come back up on the Kiroshi logo, and sit there. Skipping that screen is a paid upgrade.\n\n25% chance per shot to blind the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackSonic1"); ArrayPush(t, "10mm Sonic Shock [Hack]");
    ArrayPush(t, "AO-Ammo-HackSonic1-Desc"); ArrayPush(t, "On impact this one feeds Sonic Shock into the target's audio implants and fills them with white noise, so they can't hear you move and can't hear their friends calling for help.\n\n10% chance per shot to deafen the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackSonic2"); ArrayPush(t, "10mm Sonic Shock [Hack]");
    ArrayPush(t, "AO-Ammo-HackSonic2-Desc"); ArrayPush(t, "On impact this one feeds Sonic Shock into the target's audio implants and fills them with white noise, so they can't hear you move and can't hear their friends calling for help.\n\n15% chance per shot to deafen the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackSonic3"); ArrayPush(t, "10mm Sonic Shock [Hack]");
    ArrayPush(t, "AO-Ammo-HackSonic3-Desc"); ArrayPush(t, "On impact this one feeds Sonic Shock into the target's audio implants and fills them with white noise, so they can't hear you move and can't hear their friends calling for help.\n\n20% chance per shot to deafen the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackSonic4"); ArrayPush(t, "10mm Sonic Shock [Hack]");
    ArrayPush(t, "AO-Ammo-HackSonic4-Desc"); ArrayPush(t, "The target's audio implants lock onto one Night City radio station at full volume and won't change the channel. The ad breaks alone would make anyone drop their gun.\n\n25% chance per shot to deafen the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackContagion1"); ArrayPush(t, "10mm Contagion [Hack]");
    ArrayPush(t, "AO-Ammo-HackContagion1-Desc"); ArrayPush(t, "The Contagion routine rides in the seeker head. On a hit it gets into the target's implants and starts them poisoning their own blood, then looks for other implant links in a short radius and does the same there.\n\n4% chance per shot to poison the target and whoever's close.");
    ArrayPush(t, "AO-Ammo-10mm-HackContagion2"); ArrayPush(t, "10mm Contagion [Hack]");
    ArrayPush(t, "AO-Ammo-HackContagion2-Desc"); ArrayPush(t, "The Contagion routine rides in the seeker head. On a hit it gets into the target's implants and starts them poisoning their own blood, then looks for other implant links in a short radius and does the same there.\n\n6% chance per shot to poison the target and whoever's close.");
    ArrayPush(t, "AO-Ammo-10mm-HackContagion3"); ArrayPush(t, "10mm Contagion [Hack]");
    ArrayPush(t, "AO-Ammo-HackContagion3-Desc"); ArrayPush(t, "The Contagion routine rides in the seeker head. On a hit it gets into the target's implants and starts them poisoning their own blood, then looks for other implant links in a short radius and does the same there.\n\n8% chance per shot to poison the target and whoever's close.");
    ArrayPush(t, "AO-Ammo-10mm-HackContagion4"); ArrayPush(t, "10mm Contagion [Hack]");
    ArrayPush(t, "AO-Ammo-HackContagion4-Desc"); ArrayPush(t, "It gets into the target's implants and poisons their blood, then jumps to every implant link within five metres. Five metres in Night City is a lot of people.\n\n10% chance per shot to poison the target and whoever's close.");
    ArrayPush(t, "AO-Ammo-10mm-HackCyberware1"); ArrayPush(t, "10mm Cyberware Malfunction [Hack]");
    ArrayPush(t, "AO-Ammo-HackCyberware1-Desc"); ArrayPush(t, "The program on the chip gets into the target's implants on a hit and shuts them down. Whatever chrome they lean on stops working until their system sorts itself out.\n\n10% chance per shot to make the target's cyberware fail.");
    ArrayPush(t, "AO-Ammo-10mm-HackCyberware2"); ArrayPush(t, "10mm Cyberware Malfunction [Hack]");
    ArrayPush(t, "AO-Ammo-HackCyberware2-Desc"); ArrayPush(t, "The program on the chip gets into the target's implants on a hit and shuts them down. Whatever chrome they lean on stops working until their system sorts itself out.\n\n15% chance per shot to make the target's cyberware fail.");
    ArrayPush(t, "AO-Ammo-10mm-HackCyberware3"); ArrayPush(t, "10mm Cyberware Malfunction [Hack]");
    ArrayPush(t, "AO-Ammo-HackCyberware3-Desc"); ArrayPush(t, "The program on the chip gets into the target's implants on a hit and shuts them down. Whatever chrome they lean on stops working until their system sorts itself out.\n\n20% chance per shot to make the target's cyberware fail.");
    ArrayPush(t, "AO-Ammo-10mm-HackCyberware4"); ArrayPush(t, "10mm Cyberware Malfunction [Hack]");
    ArrayPush(t, "AO-Ammo-HackCyberware4-Desc"); ArrayPush(t, "Every implant the target owns shuts off at once. Whatever they bolted on to make themselves scary is just weight now.\n\n25% chance per shot to make the target's cyberware fail.");
    ArrayPush(t, "AO-Ammo-10mm-HackShort1"); ArrayPush(t, "10mm Short Circuit [Hack]");
    ArrayPush(t, "AO-Ammo-HackShort1-Desc"); ArrayPush(t, "A capacitor in the body and Short Circuit on the chip. The program opens the target's implant power bus and the capacitor dumps into it, which runs current through every piece of chrome they have.\n\n4% chance per shot to overload the target's systems.");
    ArrayPush(t, "AO-Ammo-10mm-HackShort2"); ArrayPush(t, "10mm Short Circuit [Hack]");
    ArrayPush(t, "AO-Ammo-HackShort2-Desc"); ArrayPush(t, "A capacitor in the body and Short Circuit on the chip. The program opens the target's implant power bus and the capacitor dumps into it, which runs current through every piece of chrome they have.\n\n6% chance per shot to overload the target's systems.");
    ArrayPush(t, "AO-Ammo-10mm-HackShort3"); ArrayPush(t, "10mm Short Circuit [Hack]");
    ArrayPush(t, "AO-Ammo-HackShort3-Desc"); ArrayPush(t, "A capacitor in the body and Short Circuit on the chip. The program opens the target's implant power bus and the capacitor dumps into it, which runs current through every piece of chrome they have.\n\n8% chance per shot to overload the target's systems.");
    ArrayPush(t, "AO-Ammo-10mm-HackShort4"); ArrayPush(t, "10mm Short Circuit [Hack]");
    ArrayPush(t, "AO-Ammo-HackShort4-Desc"); ArrayPush(t, "Puts enough current through the target's chrome to light every LED on them from across the room. Handy in the dark.\n\n10% chance per shot to overload the target's systems.");
    ArrayPush(t, "AO-Ammo-10mm-HackCripple1"); ArrayPush(t, "10mm Cripple Movement [Hack]");
    ArrayPush(t, "AO-Ammo-HackCripple1-Desc"); ArrayPush(t, "On a hit the program goes through the target's implant link to the motor controllers in their legs and jams them. The legs don't work again until it clears.\n\n10% chance per shot to cripple the target's legs.");
    ArrayPush(t, "AO-Ammo-10mm-HackCripple2"); ArrayPush(t, "10mm Cripple Movement [Hack]");
    ArrayPush(t, "AO-Ammo-HackCripple2-Desc"); ArrayPush(t, "On a hit the program goes through the target's implant link to the motor controllers in their legs and jams them. The legs don't work again until it clears.\n\n15% chance per shot to cripple the target's legs.");
    ArrayPush(t, "AO-Ammo-10mm-HackCripple3"); ArrayPush(t, "10mm Cripple Movement [Hack]");
    ArrayPush(t, "AO-Ammo-HackCripple3-Desc"); ArrayPush(t, "On a hit the program goes through the target's implant link to the motor controllers in their legs and jams them. The legs don't work again until it clears.\n\n20% chance per shot to cripple the target's legs.");
    ArrayPush(t, "AO-Ammo-10mm-HackCripple4"); ArrayPush(t, "10mm Cripple Movement [Hack]");
    ArrayPush(t, "AO-Ammo-HackCripple4-Desc"); ArrayPush(t, "Locks the target's leg controllers so hard they stand there like a mannequin in a Jinguji window while the fight goes on around them.\n\n25% chance per shot to cripple the target's legs.");
    ArrayPush(t, "AO-Ammo-10mm-HackOverheat1"); ArrayPush(t, "10mm Overheat [Hack]");
    ArrayPush(t, "AO-Ammo-HackOverheat1-Desc"); ArrayPush(t, "Smart rounds carrying Overheat. The program tells the target's implants to dump their heat all at once, and the chrome gets hot enough to burn the meat it's bolted into.\n\n10% chance per shot to burn the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackOverheat2"); ArrayPush(t, "10mm Overheat [Hack]");
    ArrayPush(t, "AO-Ammo-HackOverheat2-Desc"); ArrayPush(t, "Smart rounds carrying Overheat. The program tells the target's implants to dump their heat all at once, and the chrome gets hot enough to burn the meat it's bolted into.\n\n15% chance per shot to burn the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackOverheat3"); ArrayPush(t, "10mm Overheat [Hack]");
    ArrayPush(t, "AO-Ammo-HackOverheat3-Desc"); ArrayPush(t, "Smart rounds carrying Overheat. The program tells the target's implants to dump their heat all at once, and the chrome gets hot enough to burn the meat it's bolted into.\n\n20% chance per shot to burn the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackOverheat4"); ArrayPush(t, "10mm Overheat [Hack]");
    ArrayPush(t, "AO-Ammo-HackOverheat4-Desc"); ArrayPush(t, "Runs the target's chrome hot enough that they start to smell like a food cart on Jig-Jig Street, and that's before the clothes catch.\n\n25% chance per shot to burn the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackGlitch1"); ArrayPush(t, "10mm Weapon Glitch [Hack]");
    ArrayPush(t, "AO-Ammo-HackGlitch1-Desc"); ArrayPush(t, "Most guns in this town talk to the chrome in the hand holding them. On a hit the program goes down that link and jams the gun, and it stays jammed until the glitch clears.\n\n10% chance per shot to jam the target's weapon.");
    ArrayPush(t, "AO-Ammo-10mm-HackGlitch2"); ArrayPush(t, "10mm Weapon Glitch [Hack]");
    ArrayPush(t, "AO-Ammo-HackGlitch2-Desc"); ArrayPush(t, "Most guns in this town talk to the chrome in the hand holding them. On a hit the program goes down that link and jams the gun, and it stays jammed until the glitch clears.\n\n15% chance per shot to jam the target's weapon.");
    ArrayPush(t, "AO-Ammo-10mm-HackGlitch3"); ArrayPush(t, "10mm Weapon Glitch [Hack]");
    ArrayPush(t, "AO-Ammo-HackGlitch3-Desc"); ArrayPush(t, "Most guns in this town talk to the chrome in the hand holding them. On a hit the program goes down that link and jams the gun, and it stays jammed until the glitch clears.\n\n20% chance per shot to jam the target's weapon.");
    ArrayPush(t, "AO-Ammo-10mm-HackGlitch4"); ArrayPush(t, "10mm Weapon Glitch [Hack]");
    ArrayPush(t, "AO-Ammo-HackGlitch4-Desc"); ArrayPush(t, "The target's gun locks up and starts a firmware update. Anyone who has owned a Kang Tao knows how long those take.\n\n25% chance per shot to jam the target's weapon.");
    ArrayPush(t, "AO-Ammo-10mm-HackBurnout2"); ArrayPush(t, "10mm Synapse Burnout [Hack]");
    ArrayPush(t, "AO-Ammo-HackBurnout2-Desc"); ArrayPush(t, "Netrunners sell these and don't ask what for. On a hit the program floods the target's neural port with junk until the port burns out, and it takes a good part of the brain with it.\n\n6% chance per shot to burn out the target's brain.");
    ArrayPush(t, "AO-Ammo-10mm-HackBurnout3"); ArrayPush(t, "10mm Synapse Burnout [Hack]");
    ArrayPush(t, "AO-Ammo-HackBurnout3-Desc"); ArrayPush(t, "Netrunners sell these and don't ask what for. On a hit the program floods the target's neural port with junk until the port burns out, and it takes a good part of the brain with it.\n\n8% chance per shot to burn out the target's brain.");
    ArrayPush(t, "AO-Ammo-10mm-HackBurnout4"); ArrayPush(t, "10mm Synapse Burnout [Hack]");
    ArrayPush(t, "AO-Ammo-HackBurnout4-Desc"); ArrayPush(t, "Pushes enough through the target's neural port to cook what's on the other side of it. Open casket's still an option. Nothing shows from the outside.\n\n10% chance per shot to burn out the target's brain.");
    ArrayPush(t, "AO-Ammo-10mm-HackPsycho3"); ArrayPush(t, "10mm Cyberpsychosis [Hack]");
    ArrayPush(t, "AO-Ammo-HackPsycho3-Desc"); ArrayPush(t, "The Cyberpsychosis routine, on a smart round's seeker chip. The program switches the target's threat filter off and everything with a pulse reads hostile to them, including whoever they came in with. It wears off after a short while.\n\n20% chance per shot to drive the target mad.");
    ArrayPush(t, "AO-Ammo-10mm-HackPsycho4"); ArrayPush(t, "10mm Cyberpsychosis [Hack]");
    ArrayPush(t, "AO-Ammo-HackPsycho4-Desc"); ArrayPush(t, "For thirty seconds the target forgets whose side they're on and goes after their own crew. Thirty seconds is longer than most of the crew will last.\n\n25% chance per shot to drive the target mad.");
    ArrayPush(t, "AO-Ammo-10mm-HackGrenade3"); ArrayPush(t, "10mm Detonate Grenade [Hack]");
    ArrayPush(t, "AO-Ammo-HackGrenade3-Desc"); ArrayPush(t, "There's a charge in the body of this one. The program on the chip arms it on the way in and sets it off on the hit, and anyone standing within a few steps of the target gets hurt too.\n\n20% chance per shot to blow up the target.");
    ArrayPush(t, "AO-Ammo-10mm-HackGrenade4"); ArrayPush(t, "10mm Detonate Grenade [Hack]");
    ArrayPush(t, "AO-Ammo-HackGrenade4-Desc"); ArrayPush(t, "A charge in the body of the round with enough behind it to reach everyone within five metres of the target. Nobody's going to ask who you were aiming at.\n\n25% chance per shot to blow up the target.");
    ArrayPush(t, "AO-Ammo-20mm-EMPPayload"); ArrayPush(t, "20mm EMP Payload");
